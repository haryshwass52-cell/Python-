RATE_CARD = {
    "APR_JUN": {
        "base_rate": 32.00,
        "fat_step_value": 0.45,
        "base_fat": 3.50,  # Update if your original problem specifies a different base fat %
        "base_snf": 8.50,  # Update if your original problem specifies a different base SNF %
