        "fat_step_value": 0.40,  # <-- Replace with original Task 1 fat step
        "base_fat": 3.50,
        "base_snf": 8.50,
        "snf_step_value": 0.30,
    },
}

BONUS_VOLUME_THRESHOLD = 500.0  # Litres in ten days
BONUS_RATE_PER_LITRE = 0.50  # Rs 0.50 per litre


def get_rate_card(season: str) -> dict:
    """Selects the appropriate rate card based on the season."""
    season_key = season.strip().upper()
    if season_key in ["APRIL", "MAY", "JUNE", "APR_JUN"]:
        return RATE_CARD["APR_JUN"]
    return RATE_CARD["OTHER"]


def calculate_step_units(reading: float, base: float) -> int:
    """Calculates discrete 0.1 step increments from two-decimal analyzer readings.

    Using round() prevents floating-point precision errors (e.g., 4.12 - 3.50 =
    0.6200000000000001).
    """
    diff = round(reading - base, 2)
    # Using int(diff * 10) floors partial 0.01 steps; use round(diff * 10) if nearest step is required
    return int(round(diff * 10, 2))


def calculate_rate_per_litre(fat: float, snf: float, season: str) -> float:
    """Calculates the milk rate per litre using two-decimal readings and seasonal rates."""
    rates = get_rate_card(season)

    fat_steps = calculate_step_units(fat, rates["base_fat"])
    snf_steps = calculate_step_units(snf, rates["base_snf"])

    fat_adjustment = fat_steps * rates["fat_step_value"]
    snf_adjustment = snf_steps * rates["snf_step_value"]

    rate_per_litre = rates["base_rate"] + fat_adjustment + snf_adjustment
    return round(rate_per_litre, 2)


def calculate_volume_bonus(total_litres_10_days: float) -> float:
    """Separate bonus function for farmers supplying more than 500 litres in 10 days."""
    if total_litres_10_days > BONUS_VOLUME_THRESHOLD:
        return round(total_litres_10_days * BONUS_RATE_PER_LITRE, 2)
    return 0.0


def calculate_total_payout(
    fat: float, snf: float, litres: float, season: str
) -> dict:
    """Computes the complete payout breakdown for a 10-day cycle."""
    rate = calculate_rate_per_litre(fat, snf, season)
    base_payout = round(rate * litres, 2)
    bonus = calculate_volume_bonus(litres)
    total_payout = round(base_payout + bonus, 2)

    return {
        "season": season,
        "fat": fat,
        "snf": snf,
        "litres": litres,
        "rate_per_litre": rate,
        "base_payout": base_payout,
        "bonus": bonus,
        "total_payout": total_payout,
    }


